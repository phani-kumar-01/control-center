+static DEFINE_MUTEX(clevo_fan_lock);
+static bool clevo_fan_manual_active;
+static struct delayed_work clevo_fan_watchdog_work;
+
+static void clevo_fan_watchdog_work_fn(struct work_struct *work)
+{
+	u32 result = 0;
+
+	mutex_lock(&clevo_fan_lock);
+	if (!clevo_fan_manual_active) {
+		mutex_unlock(&clevo_fan_lock);
+		return;
+	}
+	clevo_fan_manual_active = false;
+	mutex_unlock(&clevo_fan_lock);
+
+	pr_warn("Clevo fan watchdog expired (15s), restoring EC auto\n");
+	clevo_evaluate_method(CLEVO_CMD_SET_FANSPEED_AUTO, 0x0F, &result);
+}
+
+static void clevo_fan_watchdog_release(void)
+{
+	bool was_active;
+	u32 result = 0;
+
+	mutex_lock(&clevo_fan_lock);
+	was_active = clevo_fan_manual_active;
+	clevo_fan_manual_active = false;
+	mutex_unlock(&clevo_fan_lock);
+
+	cancel_delayed_work_sync(&clevo_fan_watchdog_work);
+
+	if (was_active) {
+		pr_info("restoring Clevo fans to EC auto\n");
+		clevo_evaluate_method(CLEVO_CMD_SET_FANSPEED_AUTO, 0x0F, &result);
+	}
+}
+
